# Database Configuration
# For multi-backend setup: Use shared PostgreSQL container with separate databases
DATABASE_URL=postgresql://user:password@postgres:5432/athletes_match_db

# API Configuration
SECRET_KEY=change-this-to-a-random-secret-key-in-production
API_PORT=8000

# CORS Configuration
# Add your Netlify domain here (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,https://your-netlify-domain.netlify.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
